<Window x:Class="DevHUD___Command_Scratchpad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:DevHUD___Command_Scratchpad"
        xmlns:vm="clr-namespace:DevHUD___Command_Scratchpad.ViewModels"
        mc:Ignorable="d"
        Title="DevHUD - Tactical Scratchpad &amp; Task Runner"
        Icon="Resources/app_icon.png"
        Height="680" Width="1020"
        MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter" />
    </Window.Resources>

    <Border x:Name="WindowBorder"
            Background="#0D1117"
            BorderBrush="{Binding IsGhostMode, Converter={local:GhostModeBorderBrushConverter}}"
            BorderThickness="1.5"
            CornerRadius="12"
            Opacity="{Binding GhostOpacity}">

        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Color="#00F0FF"
                              Opacity="{Binding IsGhostMode, Converter={local:GhostModeShadowOpacityConverter}}"
                              Direction="270"
                              ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>

                <RowDefinition Height="46" />

                <RowDefinition Height="*" />

                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,10,0">
                        <Border Background="#1F2937" CornerRadius="6" Padding="6,3" BorderBrush="#00F0FF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Resources/app_icon.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="DevHUD" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="PomodoroPill"
                                Visibility="{Binding ActivePomodoro, Converter={local:NullToVisibilityConverter}}"
                                Background="#3B2303"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,3"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏳" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActivePomodoro.FormattedTime, FallbackValue='25:00'}"
                                           FontWeight="Bold" FontSize="11" Foreground="#FBBF24" VerticalAlignment="Center" />
                                <TextBlock Text=" • " Foreground="#D97706" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActivePomodoro.TaskTitle, FallbackValue='Đang tập trung'}"
                                           MaxWidth="140" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#FDE68A" VerticalAlignment="Center" />
                                <Button Content="✕"
                                        Command="{Binding StopActivePomodoroCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#F87171"
                                        FontWeight="Bold"
                                        FontSize="10"
                                        Margin="6,0,0,0"
                                        Cursor="Hand"
                                        ToolTip="Hủy Pomodoro" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1"
                                  Visibility="{Binding IsGhostMode, Converter={StaticResource InverseBoolToVisConverter}}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="6,4,6,4"
                                  VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TabItemBorder"
                                                CornerRadius="6"
                                                Margin="2,0"
                                                Padding="10,4,6,4"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="TabItem_MouseLeftButtonDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#0D1117" />
                                                    <Setter Property="BorderBrush" Value="#30363D" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{local:SelectedTabHighlightConverter}">
                                                                    <Binding Path="." />
                                                                    <Binding Path="DataContext.CurrentTab" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="#1C2333" />
                                                            <Setter Property="BorderBrush" Value="#00F0FF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12"
                                                         FontWeight="SemiBold"
                                                         Foreground="#E6EDF3"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         VerticalAlignment="Center"
                                                         LostFocus="TabTitle_LostFocus" />

                                                <Border Background="#21262D" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                                    <TextBlock FontSize="9" Foreground="#8B949E">
                                                        <Run Text="{Binding CompletedTasks, Mode=OneWay}" />
                                                        <Run Text="/" />
                                                        <Run Text="{Binding TotalTasks, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>

                                                <Button Content="×"
                                                        Click="CloseTab_Click"
                                                        Tag="{Binding .}"
                                                        Background="Transparent"
                                                        Foreground="#8B949E"
                                                        BorderThickness="0"
                                                        FontSize="14"
                                                        Margin="6,0,0,0"
                                                        Padding="2,0"
                                                        Cursor="Hand"
                                                        ToolTip="Đóng tab" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource TacticalPillButton}"
                                    Command="{Binding AddTabCommand}"
                                    Content="{Binding L10n.AddTabButton}"
                                    Margin="4,0"
                                    Padding="8,3"
                                    ToolTip="{Binding L10n.AddTabToolTip}" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">

                        <Button Style="{StaticResource TacticalPillButton}"
                                Command="{Binding ToggleLanguageCommand}"
                                ToolTip="{Binding L10n.LanguageToggleToolTip}"
                                Margin="0,0,6,0">
                            <TextBlock Text="{Binding L10n.LanguageBadge}" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" />
                        </Button>

                        <Button Style="{StaticResource TacticalPillButton}"
                                Command="{Binding ToggleHelpCommand}"
                                ToolTip="{Binding L10n.HelpToolTip}"
                                Margin="0,0,6,0">
                            <TextBlock Text="{Binding L10n.HelpButton}" FontWeight="Bold" FontSize="11" Foreground="#F59E0B" />
                        </Button>

                        <Button Style="{StaticResource TacticalPillButton}"
                                Command="{Binding SortCurrentTabTasksCommand}"
                                ToolTip="{Binding L10n.SortToolTip}"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Margin="0,0,3,0" Foreground="#00F0FF" />
                                <TextBlock Text="{Binding L10n.SortButton}" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TacticalPillButton}"
                                Command="{Binding ToggleGhostModeCommand}"
                                ToolTip="{Binding L10n.GhostToolTip}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👻" Margin="0,0,3,0" />
                                <TextBlock Text="{Binding L10n.GhostButton}" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <Border CornerRadius="6" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="—" Click="MinimizeButton_Click" Width="28" Height="26" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand" ToolTip="{Binding L10n.MinimizeToolTip}" />
                                <Button Content="□" Click="MaximizeButton_Click" Width="28" Height="26" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand" ToolTip="{Binding L10n.MaximizeToolTip}" />
                                <Button Content="✕" Click="CloseButton_Click" Width="28" Height="26" Background="Transparent" Foreground="#F85149" BorderThickness="0" Cursor="Hand" ToolTip="{Binding L10n.CloseToolTip}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">

                <Grid Visibility="{Binding IsGhostMode, Converter={StaticResource InverseBoolToVisConverter}}">
                    <avalonEdit:TextEditor x:Name="MainEditor"
                                           Background="#0D1117"
                                           Foreground="#E6EDF3"
                                           FontFamily="Cascadia Code, JetBrains Mono, Consolas, Courier New"
                                           FontSize="14"
                                           ShowLineNumbers="True"
                                           LineNumbersForeground="#484F58"
                                           WordWrap="True"
                                           Padding="14,12"
                                           Margin="2"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"
                                           TextChanged="MainEditor_TextChanged" />
                </Grid>

                <Grid Visibility="{Binding IsGhostMode, Converter={StaticResource BoolToVisConverter}}"
                      Background="#0B0F17"
                      Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#161B22"
                            BorderBrush="#00F0FF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👻" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="TACTICAL GHOST REMINDER" FontWeight="Bold" FontSize="12" Foreground="#00F0FF" />
                                    <TextBlock Text=" • VIỆC CẦN LÀM" FontSize="12" Foreground="#8B949E" />
                                </StackPanel>
                                <TextBlock Text="Chỉ hiển thị các đầu việc chưa hoàn thành để giữ tập trung tối đa."
                                           FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource TacticalPillButton}"
                                    Command="{Binding ToggleGhostModeCommand}"
                                    Content="Thoát Ghost (Ctrl+T)"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding GhostTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#121820"
                                            BorderBrush="#21262D"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,0,0,6"
                                            Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto" />

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Click="CompleteGhostTask_Click"
                                                    Tag="{Binding .}"
                                                    Background="#1F2937"
                                                    BorderBrush="#38BDF8"
                                                    BorderThickness="1"
                                                    Width="22" Height="22"
                                                    Cursor="Hand"
                                                    ToolTip="Bấm để đánh dấu hoàn thành"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="{Binding DisplayText}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="#F0F6FC"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding TabTitle}"
                                                               FontSize="10" Foreground="#58A6FF" />
                                                    <TextBlock Text=" • Dòng " FontSize="10" Foreground="#484F58" />
                                                    <TextBlock Text="{Binding LineNumber}" FontSize="10" Foreground="#484F58" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                                <Border Visibility="{Binding IsHabit, Converter={StaticResource BoolToVisConverter}}"
                                                        Background="#2E1065" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                                    <TextBlock Text="[H] Thói quen" FontSize="10" FontWeight="SemiBold" Foreground="#D8B4FE" />
                                                </Border>

                                                <Border Visibility="{Binding Streak, Converter={local:StringToVisibilityConverter}}"
                                                        Background="#451A03" BorderBrush="#F97316" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding Streak}" FontSize="10" FontWeight="Bold" Foreground="#FB923C" />
                                                </Border>

                                                <Border Visibility="{Binding HasActiveTimer, Converter={StaticResource BoolToVisConverter}}"
                                                        Background="#3B2303" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="5,2">
                                                    <TextBlock Text="{Binding TimerDisplay}" FontSize="10" FontWeight="Bold" Foreground="#FBBF24" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Text="💡 Mẹo: Nhấn Alt + Q để ẩn/hiện DevHUD tức thì từ bất kỳ đâu trên Windows."
                               FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding L10n.ProgressLabel}" FontSize="10" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ProgressBar Style="{StaticResource TacticalProgressBarStyle}"
                                     Width="140"
                                     Value="{Binding CurrentTab.CompletionPercentage, Mode=OneWay, FallbackValue=0}"
                                     Maximum="100"
                                     VerticalAlignment="Center" />
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Run Text="{Binding CurrentTab.CompletedTasks, Mode=OneWay, FallbackValue=0}" />
                            <Run Text="/" />
                            <Run Text="{Binding CurrentTab.TotalTasks, Mode=OneWay, FallbackValue=0}" />
                            <Run Text=" (" />
                            <Run Text="{Binding CurrentTab.CompletionPercentage, Mode=OneWay, FallbackValue=0}" />
                            <Run Text="%)" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,8,0">
                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11"
                                   Foreground="#C9D1D9"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource KeybindingBadge}">
                            <TextBlock Text="{Binding L10n.BadgeDone}" FontSize="10" Foreground="#8B949E" />
                        </Border>
                        <Border Style="{StaticResource KeybindingBadge}">
                            <TextBlock Text="{Binding L10n.BadgePomodoro}" FontSize="10" Foreground="#F59E0B" />
                        </Border>
                        <Border Style="{StaticResource KeybindingBadge}">
                            <TextBlock Text="{Binding L10n.BadgeLaunch}" FontSize="10" Foreground="#38BDF8" />
                        </Border>
                        <Border Style="{StaticResource KeybindingBadge}">
                            <TextBlock Text="{Binding L10n.BadgeSort}" FontSize="10" Foreground="#A855F7" />
                        </Border>
                        <Border Style="{StaticResource KeybindingBadge}">
                            <TextBlock Text="{Binding L10n.BadgeGhost}" FontSize="10" Foreground="#00F0FF" />
                        </Border>
                        <Border Style="{StaticResource KeybindingBadge}">
                            <TextBlock Text="{Binding L10n.BadgeToggle}" FontSize="10" Foreground="#3FB950" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="0" Grid.RowSpan="3"
                  Visibility="{Binding IsHelpVisible, Converter={StaticResource BoolToVisConverter}}"
                  Background="#E60A0D14">

                <Border Width="780" MaxHeight="560"
                        Background="#161B22"
                        BorderBrush="#00F0FF"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="24,20"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="36" Color="#00F0FF" Opacity="0.45" ShadowDepth="0" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="*" />

                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="18" Foreground="#00F0FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding L10n.HelpModalTitle}" FontWeight="Bold" FontSize="15" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding L10n.HelpModalSubtitle}" FontSize="12" Foreground="#8B949E" Margin="26,3,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding CloseHelpCommand}"
                                    Content="✕"
                                    Width="30" Height="30"
                                    Background="#21262D"
                                    Foreground="#8B949E"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FontSize="14"
                                    VerticalAlignment="Top" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding L10n.HelpSectionHotkeys}" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" Margin="0,0,0,10" />

                                        <TextBlock Text="Ctrl + Enter" FontWeight="Bold" FontSize="11" Foreground="#58A6FF" />
                                        <TextBlock Text="Xong / Đánh dấu hoàn thành" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="F5" FontWeight="Bold" FontSize="11" Foreground="#F59E0B" />
                                        <TextBlock Text="Đếm giờ Pomodoro 25p tại dòng" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="Ctrl + Space" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" />
                                        <TextBlock Text="Phóng nhanh Web / Thư mục / Cmd" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="Ctrl + Shift + S" FontWeight="Bold" FontSize="11" Foreground="#A855F7" />
                                        <TextBlock Text="Gom đẩy việc xong xuống đáy" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="Ctrl + T" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" />
                                        <TextBlock Text="Bật/Tắt Ghost HUD ghim góc" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="Ctrl + L" FontWeight="Bold" FontSize="11" Foreground="#3FB950" />
                                        <TextBlock Text="Chuyển ngôn ngữ VI / EN" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="Ctrl + H" FontWeight="Bold" FontSize="11" Foreground="#F59E0B" />
                                        <TextBlock Text="Bảng phím tắt &amp; hướng dẫn này" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="Alt + Q" FontWeight="Bold" FontSize="11" Foreground="#3FB950" />
                                        <TextBlock Text="Ẩn/Hiện toàn cục từ mọi nơi" FontSize="10" Foreground="#8B949E" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding L10n.HelpSectionSyntax}" FontWeight="Bold" FontSize="11" Foreground="#F59E0B" Margin="0,0,0,10" />

                                        <TextBlock Text="- việc cần làm" FontWeight="Bold" FontSize="11" Foreground="#E6EDF3" />
                                        <TextBlock Text="Tác vụ thường (Bullet point)" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="- [H] thói quen" FontWeight="Bold" FontSize="11" Foreground="#D2A8FF" />
                                        <TextBlock Text="Thói quen tự reset mỗi ngày" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="[🔥 5 ngày]" FontWeight="Bold" FontSize="11" Foreground="#FB923C" />
                                        <TextBlock Text="Chuỗi Streak liên tục tự đếm" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="(hoàn thành) / (done)" FontWeight="Bold" FontSize="11" Foreground="#3FB950" />
                                        <TextBlock Text="Gạch ngang mờ việc đã xong" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="@web:https://..." FontWeight="Bold" FontSize="11" Foreground="#38BDF8" />
                                        <TextBlock Text="Mở link trình duyệt nhanh" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="@path:D:\Folder" FontWeight="Bold" FontSize="11" Foreground="#C084FC" />
                                        <TextBlock Text="Mở thư mục trong Explorer" FontSize="10" Foreground="#8B949E" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding L10n.HelpSectionFeatures}" FontWeight="Bold" FontSize="11" Foreground="#3FB950" Margin="0,0,0,10" />

                                        <TextBlock Text="💾 Tự Động Lưu Dữ Liệu" FontWeight="Bold" FontSize="11" Foreground="#F0F6FC" />
                                        <TextBlock Text="Lưu realtime sau 600ms vào thư mục %LocalAppData%\DevHUD" TextWrapping="Wrap" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="📦 Daily Backup Snapshot" FontWeight="Bold" FontSize="11" Foreground="#F0F6FC" />
                                        <TextBlock Text="Tự động sao lưu lịch sử làm việc mỗi ngày vào thư mục snapshots" TextWrapping="Wrap" FontSize="10" Foreground="#8B949E" Margin="0,1,0,8" />

                                        <TextBlock Text="⚡ Zero-Friction Engine" FontWeight="Bold" FontSize="11" Foreground="#F0F6FC" />
                                        <TextBlock Text="Không cần chuột, điều khiển 100% bằng phím tắt như một Hacker!" TextWrapping="Wrap" FontSize="10" Foreground="#8B949E" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <Button Grid.Row="2"
                                Command="{Binding CloseHelpCommand}"
                                Content="{Binding L10n.HelpCloseButton}"
                                Style="{StaticResource TacticalPillButton}"
                                HorizontalAlignment="Right"
                                Padding="16,6" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
